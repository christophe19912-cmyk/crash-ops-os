# Crash Ops OS — Supabase browser configuration
# Copy browser-safe values to .env.local.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# CCC estimate intake — SERVER ONLY (configure in Vercel, never expose with VITE_ prefix)
OPENAI_API_KEY=YOUR_SERVER_SIDE_OPENAI_API_KEY
# Optional model override. Defaults to gpt-5.
OPENAI_ESTIMATE_MODEL=gpt-5

# Do not put a Supabase service-role key or OPENAI_API_KEY in client-side VITE_ variables.
